# Copy this file to ".env" in the project root and fill in values.
# Never commit the real .env file.

# --- PostgreSQL (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/forensics_db

# --- JWT auth ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- IPFS (Pinata) — optional depending on features you use ---
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=

# --- Local Ganache / contract (from your Truffle migrate output) ---
GANACHE_URL=http://127.0.0.1:7545
CHAIN_ID=1337
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Test keys only — use accounts from YOUR local Ganache; never reuse mainnet keys
LEGAL_AUTHORITY_PRIVATE_KEY=0xYOUR_64_HEX_CHARS_HERE
FORENSIC_ANALYST_PRIVATE_KEY=0xYOUR_64_HEX_CHARS_HERE

# --- Optional paths ---
# DATA_DIR=
# MODEL_DIR=
